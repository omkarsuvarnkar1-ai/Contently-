# ==============================================================================
# Contently AI Content Platform - PostgreSQL Backend Configuration
# ==============================================================================
# Copy this file to .env before starting the backend:
#   copy backend\.env.example backend\.env (Windows) or cp backend/.env.example backend/.env (Linux/macOS)
# Never commit real credentials to Git.
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated origins allowed to make API requests)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:8000

# ==============================================================================
# Database: PostgreSQL (Installed locally)
# ==============================================================================
# You can specify the connection in either of two ways:
# Option A: Single DATABASE_URL (Recommended)
# Replace 'your_pg_password' with the password you set during PostgreSQL installation:
DATABASE_URL=postgresql://postgres:Omkar@123localhost:5432/contently_db

# Option B: Granular parameters (Will automatically assemble DATABASE_URL if set)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_pg_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=contently_db

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Generate a secure 32+ character key using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=contently_super_secret_jwt_key_replace_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Seeded Demo User
DEMO_USER_EMAIL=demo@contently.local
DEMO_USER_PASSWORD=ContentlyDemo123!
DEMO_USER_NAME=Omkar Suvarnkar 

# ==============================================================================
# AI Provider Credentials (Server-side Only)
# ==============================================================================
# Default provider used if not specified in request: openai | gemini | anthropic
DEFAULT_AI_PROVIDER=openai

# 1. OpenAI API Key
# Obtain at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 2. Google Gemini API Key
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=GCP_API_KEY=your_actual_key_here

GEMINI_MODEL=gemini-1.5-flash

# 3. Anthropic Claude API Key
# Obtain at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ==============================================================================
# External Integrations (Optional)
# ==============================================================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/integrations/linkedin/callback

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ==============================================================================
# Razorpay Subscriptions & Payments
# ==============================================================================
# 1. Razorpay API Keys (Dashboard -> Settings -> API Keys)
# In test mode, keys start with 'rzp_test_...'. In live mode, they start with 'rzp_live_...'.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# 2. Razorpay Webhook Secret (Dashboard -> Settings -> Webhooks)
# Secret entered when registering your webhook endpoint (e.g. http://localhost:8000/api/billing/webhook)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# 3. Currency configuration ('INR' or 'USD')
# Contently UI displays Indian Rupee (INR ₹3,999/mo) by default for domestic UPI, Cards, Netbanking.
# For international USD card checkouts, you can set to 'USD' ($49/mo).
RAZORPAY_CURRENCY=INR

# 4. Optional: Recurring Plan IDs from Razorpay Subscriptions Dashboard
# If left blank, the backend automatically initializes standard Razorpay checkout orders.
# When recurring plans are created in Razorpay Dashboard (Subscriptions -> Plans):
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=

# 5. Public Application URL (Used for webhook callbacks and return redirects)
PUBLIC_APP_URL=http://localhost:3000
